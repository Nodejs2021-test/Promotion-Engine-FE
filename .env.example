# Copy to .env (not committed). Vite reads it when `npm run dev` / `npm run build` starts, so restart after a change.

# Backend the React app calls (no trailing slash).
#   Local:  http://localhost:8000
#   ngrok:  https://xxxx.ngrok-free.app   (the backend tunnel's URL)
# Leave empty to call /api on the same origin; the Vite dev server then forwards it to VITE_API_TARGET
# (default http://127.0.0.1:8000). That way a single ngrok tunnel to :5173 is enough.
VITE_API_URL=
